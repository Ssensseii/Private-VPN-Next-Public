{
  "dns": {
    "final": "dns-remote",
    "rules": [
      {
        "domain_suffix": [
          "example.com",
          "example.org"
        ],
        "action": "route",
        "server": "dns-direct",
        "strategy": "prefer_ipv4"
      },
      {
        "process_path": [
          "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"
        ],
        "action": "route",
        "server": "dns-direct",
        "strategy": "prefer_ipv4"
      }
    ],
    "servers": [
      {
        "type": "https",
        "tag": "dns-remote",
        "server": "1.1.1.1",
        "server_port": 443,
        "path": "/dns-query",
        "tls": {
          "enabled": true,
          "server_name": "cloudflare-dns.com"
        },
        "detour": "proxy"
      },
      {
        "server": "77.88.8.8",
        "tag": "dns-direct",
        "type": "udp"
      }
    ],
    "strategy": "ipv4_only"
  },
  "inbounds": [
    {
      "address": [
        "172.19.0.1/30",
        "fdfe:dcba:9876::1/126"
      ],
      "auto_route": true,
      "interface_name": "PrivateVPN-Next",
      "mtu": 9000,
      "stack": "mixed",
      "strict_route": true,
      "tag": "tun-in",
      "type": "tun"
    }
  ],
  "log": {
    "level": "info",
    "timestamp": true
  },
  "outbounds": [
    {
      "server": "proxy.example.net",
      "server_port": 1080,
      "tag": "proxy",
      "type": "socks",
      "version": "5"
    },
    {
      "tag": "direct",
      "type": "direct"
    },
    {
      "server": "127.0.0.1",
      "server_port": 2081,
      "tag": "accel",
      "type": "socks",
      "version": "5"
    }
  ],
  "route": {
    "auto_detect_interface": true,
    "default_domain_resolver": "dns-direct",
    "final": "accel",
    "find_process": true,
    "rules": [
      {
        "action": "sniff"
      },
      {
        "action": "hijack-dns",
        "protocol": "dns"
      },
      {
        "domain": "proxy.example.net",
        "port": 1080,
        "outbound": "direct"
      },
      {
        "ip_cidr": [
          "203.0.113.10/32"
        ],
        "port": 1080,
        "outbound": "direct"
      },
      {
        "ip_is_private": true,
        "outbound": "direct"
      },
      {
        "domain_suffix": [
          "example.com",
          "example.org"
        ],
        "outbound": "direct"
      },
      {
        "outbound": "direct",
        "process_path": [
          "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"
        ]
      },
      {
        "action": "reject",
        "network": "udp",
        "port": 443
      },
      {
        "network": "udp",
        "outbound": "proxy"
      }
    ]
  }
}
